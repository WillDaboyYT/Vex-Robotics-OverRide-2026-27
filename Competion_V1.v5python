{"mode":"Text","hardwareTarget":"brain","textContent":"from vex import *\nimport random\nimport math\n\n# ============================================================\n# ROBOT CONFIGURATION\n# DO NOT CHANGE PORTS\n# ============================================================\n\nbrain = Brain()\n\n# ---------------- DRIVETRAIN ----------------\n\nleft_motor_a = Motor(\n    Ports.PORT1,\n    GearSetting.RATIO_18_1,\n    False\n)\n\nleft_motor_b = Motor(\n    Ports.PORT11,\n    GearSetting.RATIO_18_1,\n    False\n)\n\nleft_drive_smart = MotorGroup(\n    left_motor_a,\n    left_motor_b\n)\n\nright_motor_a = Motor(\n    Ports.PORT10,\n    GearSetting.RATIO_18_1,\n    True\n)\n\nright_motor_b = Motor(\n    Ports.PORT20,\n    GearSetting.RATIO_18_1,\n    True\n)\n\nright_drive_smart = MotorGroup(\n    right_motor_a,\n    right_motor_b\n)\n\ndrivetrain_inertial = Inertial(Ports.PORT9)\n\ndrivetrain = SmartDrive(\n    left_drive_smart,\n    right_drive_smart,\n    drivetrain_inertial,\n    319.19,\n    320,\n    177.79999999999998,\n    MM,\n    1\n)\n\n# ---------------- CONTROLLER ----------------\n\ncontroller_1 = Controller(PRIMARY)\n\n# ---------------- MECHANISMS ----------------\n\nroller_Intake = Motor(\n    Ports.PORT12,\n    GearSetting.RATIO_18_1,\n    False\n)\n\ncascade_Lift = Motor(\n    Ports.PORT13,\n    GearSetting.RATIO_18_1,\n    False\n)\n\nclaw_Wrist = Motor(\n    Ports.PORT18,\n    GearSetting.RATIO_18_1,\n    False\n)\n\nclaw_Grab = Motor(\n    Ports.PORT19,\n    GearSetting.RATIO_18_1,\n    False\n)\n\n\n# ============================================================\n# GLOBAL SETTINGS\n# ============================================================\n\n# Driver speed starts at 80%.\n# A = -10%\n# Y = +10%\n#\n# Minimum = 20%\n# Maximum = 100%\n\ndrive_speed = 80\n\nMIN_DRIVE_SPEED = 20\nMAX_DRIVE_SPEED = 100\nDRIVE_SPEED_STEP = 10\n\n# Joystick deadband.\nJOYSTICK_DEADBAND = 5\n\n# Thermal shutdown temperature.\n#\n# At 80C or higher:\n# - Every motor stops\n# - Driver control is disabled\n# - Controller rumbles\n# - Shutdown stays latched\n#\n# The robot must be restarted to clear the shutdown.\nTHERMAL_SHUTDOWN_TEMP = 80\n\n# Warning temperature.\nTHERMAL_WARNING_TEMP = 70\n\n# Global safety flag.\nthermal_shutdown = False\n\n# Controls whether the custom driver loop is allowed to move motors.\ndriver_enabled = False\n\n\n# ============================================================\n# RANDOM SEED\n# ============================================================\n\ndef initialize_random_seed():\n    wait(100, MSEC)\n\n    seed_value = (\n        brain.battery.voltage(VOLT) * 100\n        + brain.battery.current() * 10\n        + brain.timer.system_high_res()\n    )\n\n    random.seed(int(seed_value))\n\n\n# ============================================================\n# DRIVETRAIN CALIBRATION\n# ============================================================\n\ndef calibrate_drivetrain():\n    brain.screen.clear_screen()\n    brain.screen.set_cursor(1, 1)\n    brain.screen.print(\"Calibrating IMU...\")\n\n    drivetrain_inertial.calibrate()\n\n    while drivetrain_inertial.is_calibrating():\n        wait(50, MSEC)\n\n    brain.screen.clear_screen()\n    brain.screen.set_cursor(1, 1)\n    brain.screen.print(\"IMU Ready\")\n\n    wait(500, MSEC)\n\n\n# ============================================================\n# MOTOR SAFETY\n# ============================================================\n\ndef stop_all_motors():\n    \"\"\"\n    Stops every motor on the robot.\n\n    This is used both when the driver releases controls\n    and during thermal shutdown.\n    \"\"\"\n\n    left_motor_a.stop(BRAKE)\n    left_motor_b.stop(BRAKE)\n\n    right_motor_a.stop(BRAKE)\n    right_motor_b.stop(BRAKE)\n\n    roller_Intake.stop(BRAKE)\n    cascade_Lift.stop(BRAKE)\n    claw_Wrist.stop(BRAKE)\n    claw_Grab.stop(BRAKE)\n\n\n# ============================================================\n# TEMPERATURE FUNCTIONS\n# ============================================================\n\ndef get_motor_temperatures():\n    \"\"\"\n    Returns individual motor temperatures in Celsius.\n\n    The drivetrain is checked motor-by-motor instead of using\n    drivetrain.temperature(), because a group temperature value\n    should not be relied upon to identify the hottest motor.\n    \"\"\"\n\n    return [\n        (\"LF\", left_motor_a.temperature(TemperatureUnits.CELSIUS)),\n        (\"LB\", left_motor_b.temperature(TemperatureUnits.CELSIUS)),\n        (\"RF\", right_motor_a.temperature(TemperatureUnits.CELSIUS)),\n        (\"RB\", right_motor_b.temperature(TemperatureUnits.CELSIUS)),\n        (\"LIFT\", cascade_Lift.temperature(TemperatureUnits.CELSIUS)),\n        (\"ROLL\", roller_Intake.temperature(TemperatureUnits.CELSIUS))\n    ]\n\n\ndef get_hottest_motor():\n    \"\"\"\n    Finds the hottest motor and returns:\n\n        motor_name, temperature\n    \"\"\"\n\n    temperatures = get_motor_temperatures()\n\n    hottest_name = temperatures[0][0]\n    hottest_temp = temperatures[0][1]\n\n    for name, temperature in temperatures:\n        if temperature > hottest_temp:\n            hottest_name = name\n            hottest_temp = temperature\n\n    return hottest_name, hottest_temp\n\n\ndef get_drivetrain_temperature():\n    \"\"\"\n    Returns the hottest drivetrain motor temperature.\n    \"\"\"\n\n    temperatures = [\n        left_motor_a.temperature(TemperatureUnits.CELSIUS),\n        left_motor_b.temperature(TemperatureUnits.CELSIUS),\n        right_motor_a.temperature(TemperatureUnits.CELSIUS),\n        right_motor_b.temperature(TemperatureUnits.CELSIUS)\n    ]\n\n    hottest = temperatures[0]\n\n    for temperature in temperatures:\n        if temperature > hottest:\n            hottest = temperature\n\n    return hottest\n\n\n# ============================================================\n# THERMAL PROTECTION\n# ============================================================\n\ndef thermal_shutdown_screen(motor_name, temperature):\n    \"\"\"\n    Displays the permanent overheat screen.\n    \"\"\"\n\n    controller_1.screen.clear_screen()\n\n    controller_1.screen.set_cursor(1, 1)\n    controller_1.screen.print(\"!!! OVERHEAT !!!\")\n\n    controller_1.screen.set_cursor(2, 1)\n    controller_1.screen.print(\"MOTOR: \" + motor_name)\n\n    controller_1.screen.set_cursor(3, 1)\n    controller_1.screen.print(\"TEMP: \" + str(int(temperature)) + \"C\")\n\n\ndef monitor_temperature():\n    \"\"\"\n    Continuously monitors all six motors.\n\n    WARNING:\n        70C+\n\n    HARD SHUTDOWN:\n        80C+\n\n    The shutdown is latched and does not automatically clear\n    when the motor cools down.\n    \"\"\"\n\n    global thermal_shutdown\n\n    warning_active = False\n\n    while True:\n\n        hottest_name, hottest_temp = get_hottest_motor()\n\n        # ----------------------------------------------------\n        # HARD SHUTDOWN\n        # ----------------------------------------------------\n\n        if hottest_temp >= THERMAL_SHUTDOWN_TEMP:\n\n            thermal_shutdown = True\n            driver_enabled = False\n\n            stop_all_motors()\n\n            controller_1.rumble(\"--- --- ---\")\n\n            while thermal_shutdown:\n\n                stop_all_motors()\n\n                thermal_shutdown_screen(\n                    hottest_name,\n                    hottest_temp\n                )\n\n                # Keep checking the temperature for display,\n                # but NEVER allow the robot to restart.\n                hottest_name, hottest_temp = get_hottest_motor()\n\n                wait(250, MSEC)\n\n        # ----------------------------------------------------\n        # WARNING\n        # ----------------------------------------------------\n\n        elif hottest_temp >= THERMAL_WARNING_TEMP:\n\n            if not warning_active:\n                controller_1.rumble(\"--\")\n                warning_active = True\n\n        else:\n            warning_active = False\n\n        wait(100, MSEC)\n\n\n# ============================================================\n# DRIVER SPEED CONTROL\n# ============================================================\n\ndef increase_drive_speed():\n    global drive_speed\n\n    drive_speed += DRIVE_SPEED_STEP\n\n    if drive_speed > MAX_DRIVE_SPEED:\n        drive_speed = MAX_DRIVE_SPEED\n\n\ndef decrease_drive_speed():\n    global drive_speed\n\n    drive_speed -= DRIVE_SPEED_STEP\n\n    if drive_speed < MIN_DRIVE_SPEED:\n        drive_speed = MIN_DRIVE_SPEED\n\n\ndef monitor_drive_speed_buttons():\n    \"\"\"\n    Handles A/Y speed adjustment.\n\n    One physical press produces one 10% change.\n    Holding the button does not repeatedly change speed.\n    \"\"\"\n\n    previous_a = False\n    previous_y = False\n\n    while True:\n\n        current_a = controller_1.buttonA.pressing()\n        current_y = controller_1.buttonY.pressing()\n\n        # A = decrease\n        if current_a and not previous_a:\n            decrease_drive_speed()\n\n        # Y = increase\n        if current_y and not previous_y:\n            increase_drive_speed()\n\n        previous_a = current_a\n        previous_y = current_y\n\n        wait(20, MSEC)\n\n\n# ============================================================\n# JOYSTICK PROCESSING\n# ============================================================\n\ndef apply_deadband(value):\n    \"\"\"\n    Removes tiny joystick movements around center.\n    \"\"\"\n\n    if abs(value) <= JOYSTICK_DEADBAND:\n        return 0\n\n    return value\n\n\ndef curve_joystick(value):\n    \"\"\"\n    Cubic joystick curve.\n\n    This gives:\n        - smoother control near center\n        - still reaches full power at full joystick\n\n    Example:\n        50 -> approximately 12.5\n        100 -> 100\n    \"\"\"\n\n    if value == 0:\n        return 0\n\n    return (value * value * value) / 10000\n\n\n# ============================================================\n# DRIVER CONTROL\n# ============================================================\n\ndef driver_control_loop():\n    \"\"\"\n    Main custom driver-control loop.\n\n    Controls:\n\n        Left joystick / Axis 3 = forward / reverse\n        Axis 1 = turning\n\n        L1 = lift up\n        L2 = lift down\n\n        R1 = roller forward\n        R2 = roller reverse\n\n        D-pad Up = wrist forward\n        D-pad Down = wrist reverse\n\n        D-pad Left = claw one direction\n        D-pad Right = claw opposite direction\n\n        A = drive speed -10%\n        Y = drive speed +10%\n    \"\"\"\n\n    global driver_enabled\n\n    while True:\n\n        # ----------------------------------------------------\n        # SAFETY OVERRIDE\n        # ----------------------------------------------------\n\n        if thermal_shutdown:\n\n            stop_all_motors()\n\n            wait(20, MSEC)\n            continue\n\n        # ----------------------------------------------------\n        # DRIVER ENABLE\n        # ----------------------------------------------------\n\n        if not driver_enabled:\n\n            stop_all_motors()\n\n            wait(20, MSEC)\n            continue\n\n        # ----------------------------------------------------\n        # DRIVE\n        # ----------------------------------------------------\n\n        forward = controller_1.axis3.position()\n        turn = controller_1.axis1.position()\n\n        forward = apply_deadband(forward)\n        turn = apply_deadband(turn)\n\n        forward = curve_joystick(forward)\n        turn = curve_joystick(turn)\n\n        left_power = forward + turn\n        right_power = forward - turn\n\n        # Limit to +/-100%.\n        if left_power > 100:\n            left_power = 100\n\n        if left_power < -100:\n            left_power = -100\n\n        if right_power > 100:\n            right_power = 100\n\n        if right_power < -100:\n            right_power = -100\n\n        # Apply adjustable drive speed.\n        left_power = left_power * drive_speed / 100\n        right_power = right_power * drive_speed / 100\n\n        # Left side\n        if left_power > 0:\n\n            left_drive_smart.set_velocity(\n                abs(left_power),\n                PERCENT\n            )\n\n            left_drive_smart.spin(FORWARD)\n\n        elif left_power < 0:\n\n            left_drive_smart.set_velocity(\n                abs(left_power),\n                PERCENT\n            )\n\n            left_drive_smart.spin(REVERSE)\n\n        else:\n\n            left_drive_smart.stop(BRAKE)\n\n        # Right side\n        if right_power > 0:\n\n            right_drive_smart.set_velocity(\n                abs(right_power),\n                PERCENT\n            )\n\n            right_drive_smart.spin(FORWARD)\n\n        elif right_power < 0:\n\n            right_drive_smart.set_velocity(\n                abs(right_power),\n                PERCENT\n            )\n\n            right_drive_smart.spin(REVERSE)\n\n        else:\n\n            right_drive_smart.stop(BRAKE)\n\n        # ----------------------------------------------------\n        # CASCADE LIFT\n        # ----------------------------------------------------\n\n        if controller_1.buttonL1.pressing():\n\n            cascade_Lift.set_velocity(100, PERCENT)\n            cascade_Lift.spin(FORWARD)\n\n        elif controller_1.buttonL2.pressing():\n\n            cascade_Lift.set_velocity(100, PERCENT)\n            cascade_Lift.spin(REVERSE)\n\n        else:\n\n            cascade_Lift.stop(BRAKE)\n\n        # ----------------------------------------------------\n        # ROLLER / INTAKE\n        # ----------------------------------------------------\n\n        if controller_1.buttonR1.pressing():\n\n            roller_Intake.set_velocity(100, PERCENT)\n            roller_Intake.spin(FORWARD)\n\n        elif controller_1.buttonR2.pressing():\n\n            roller_Intake.set_velocity(100, PERCENT)\n            roller_Intake.spin(REVERSE)\n\n        else:\n\n            roller_Intake.stop(BRAKE)\n\n        # ----------------------------------------------------\n        # CLAW WRIST\n        # ----------------------------------------------------\n\n        if controller_1.buttonUp.pressing():\n\n            claw_Wrist.set_velocity(100, PERCENT)\n            claw_Wrist.spin(FORWARD)\n\n        elif controller_1.buttonDown.pressing():\n\n            claw_Wrist.set_velocity(100, PERCENT)\n            claw_Wrist.spin(REVERSE)\n\n        else:\n\n            claw_Wrist.stop(BRAKE)\n\n        # ----------------------------------------------------\n        # CLAW GRAB\n        # ----------------------------------------------------\n\n        if controller_1.buttonLeft.pressing():\n\n            claw_Grab.set_velocity(100, PERCENT)\n            claw_Grab.spin(FORWARD)\n\n        elif controller_1.buttonRight.pressing():\n\n            claw_Grab.set_velocity(100, PERCENT)\n            claw_Grab.spin(REVERSE)\n\n        else:\n\n            claw_Grab.stop(BRAKE)\n\n        wait(20, MSEC)\n\n\n# ============================================================\n# CONTROLLER STATUS SCREEN\n# ============================================================\n\ndef controller_status_screen():\n    \"\"\"\n    Controller status display.\n\n    Line 1:\n        DRIVE: 80% DT:42C\n\n    Line 2:\n        LIFT:35C ROLL:38C\n\n    Line 3:\n        A:-10% Y:+10%\n\n    DT is the hottest drivetrain motor.\n    \"\"\"\n\n    while True:\n\n        if thermal_shutdown:\n\n            wait(100, MSEC)\n            continue\n\n        drivetrain_temp = get_drivetrain_temperature()\n\n        lift_temp = cascade_Lift.temperature(\n            TemperatureUnits.CELSIUS\n        )\n\n        roller_temp = roller_Intake.temperature(\n            TemperatureUnits.CELSIUS\n        )\n\n        controller_1.screen.clear_screen()\n\n        controller_1.screen.set_cursor(1, 1)\n\n        controller_1.screen.print(\n            \"DRIVE:\" + str(drive_speed)\n            + \"% DT:\" + str(int(drivetrain_temp))\n            + \"C\"\n        )\n\n        controller_1.screen.set_cursor(2, 1)\n\n        controller_1.screen.print(\n            \"LIFT:\" + str(int(lift_temp))\n            + \"C ROLL:\" + str(int(roller_temp))\n            + \"C\"\n        )\n\n        controller_1.screen.set_cursor(3, 1)\n\n        controller_1.screen.print(\n            \"A:-10% Y:+10%\"\n        )\n\n        wait(250, MSEC)\n\n\n# ============================================================\n# PRE-AUTONOMOUS\n# ============================================================\n\ndef pre_autonomous():\n    \"\"\"\n    Runs before the match.\n\n    Autonomous movement is intentionally NOT implemented yet.\n    We need the physical robot assembled and tested before\n    distances, turns, speeds, and positions can be tuned.\n    \"\"\"\n\n    global driver_enabled\n\n    driver_enabled = False\n\n    stop_all_motors()\n\n    brain.screen.clear_screen()\n    brain.screen.set_cursor(1, 1)\n    brain.screen.print(\"Robot Initializing\")\n\n    wait(500, MSEC)\n\n    calibrate_drivetrain()\n\n    brain.screen.clear_screen()\n    brain.screen.set_cursor(1, 1)\n    brain.screen.print(\"READY\")\n\n    brain.screen.set_cursor(2, 1)\n    brain.screen.print(\"Drive: \" + str(drive_speed) + \"%\")\n\n    wait(500, MSEC)\n\n\n# ============================================================\n# AUTONOMOUS\n# ============================================================\n\ndef autonomous():\n    \"\"\"\n    Autonomous placeholder.\n\n    DO NOT add guessed distances or movements yet.\n    These will be added after the physical robot is tested.\n    \"\"\"\n\n    global driver_enabled\n\n    driver_enabled = False\n\n    stop_all_motors()\n\n    brain.screen.clear_screen()\n    brain.screen.set_cursor(1, 1)\n    brain.screen.print(\"AUTONOMOUS\")\n\n    brain.screen.set_cursor(2, 1)\n    brain.screen.print(\"NOT PROGRAMMED\")\n\n    # Placeholder only.\n    while True:\n\n        if thermal_shutdown:\n            stop_all_motors()\n\n        wait(100, MSEC)\n\n\n# ============================================================\n# DRIVER CONTROL CALLBACK\n# ============================================================\n\ndef user_control():\n    \"\"\"\n    Competition driver-control callback.\n\n    The actual motor control happens in the persistent\n    driver_control_loop thread.\n    \"\"\"\n\n    global driver_enabled\n\n    if thermal_shutdown:\n        driver_enabled = False\n        stop_all_motors()\n\n        while thermal_shutdown:\n            wait(100, MSEC)\n\n        return\n\n    driver_enabled = True\n\n    brain.screen.clear_screen()\n    brain.screen.set_cursor(1, 1)\n    brain.screen.print(\"DRIVER CONTROL\")\n\n    # Keep this callback alive during driver control.\n    while True:\n\n        if thermal_shutdown:\n            driver_enabled = False\n            stop_all_motors()\n\n        wait(100, MSEC)\n\n\n# ============================================================\n# START BACKGROUND THREADS\n# ============================================================\n\ninitialize_random_seed()\n\n# Temperature protection runs independently of driver control.\ntemperature_thread = Thread(monitor_temperature)\n\n# Driver speed button monitoring.\nspeed_thread = Thread(monitor_drive_speed_buttons)\n\n# Controller status display.\nscreen_thread = Thread(controller_status_screen)\n\n# Main custom driver-control system.\ndriver_thread = Thread(driver_control_loop)\n\n\n# ============================================================\n# COMPETITION CONTROL\n# ============================================================\n\ncompetition = Competition(\n    user_control,\n    autonomous\n)\n\n\n# ============================================================\n# START PRE-AUTONOMOUS\n# ============================================================\n\npre_autonomous()\n\n\n# ============================================================\n# MAIN PROGRAM LOOP\n# ============================================================\n\nwhile True:\n\n    if thermal_shutdown:\n        stop_all_motors()\n\n    wait(100, MSEC)","textLanguage":"python","robotConfig":[{"port":[1,11,10,20,9],"name":"drivetrain","customName":false,"deviceType":"Drivetrain","deviceClass":"smartdrive","setting":{"type":"4-motor","wheelSize":"wheel4in","gear":"ratio18_1","gearRatio":"1:1","direction":"fwd","gyroType":"inertial","width":"11.61","unit":"in","wheelbase":"7","wheelbaseUnit":"in","xOffset":"0","xOffsetUnit":"mm","yOffset":"0","yOffsetUnit":"mm","thetaOffset":"180"},"triportSourcePort":null},{"port":[],"name":"controller_1","customName":false,"deviceType":"Controller","deviceClass":"controller","setting":{"left":"cascade_Lift","leftDir":"false","right":"roller_Intake","rightDir":"false","upDown":"claw_Wrist","upDownDir":"false","xB":"","xBDir":"false","drive":"split","id":"primary"},"triportSourcePort":22},{"port":[12],"name":"roller_Intake","customName":true,"deviceType":"Motor","deviceClass":"motor","setting":{"reversed":"false","fwd":"forward","rev":"reverse","gear":"ratio18_1","id":"partner"},"triportSourcePort":22},{"port":[13],"name":"cascade_Lift","customName":true,"deviceType":"Motor","deviceClass":"motor","setting":{"reversed":"false","fwd":"forward","rev":"reverse","gear":"ratio18_1","id":"partner"}},{"port":[18],"name":"claw_Wrist","customName":true,"deviceType":"Motor","deviceClass":"motor","setting":{"reversed":"false","fwd":"forward","rev":"reverse","gear":"ratio18_1","id":"partner"}},{"port":[19],"name":"claw_Grab","customName":true,"deviceType":"Motor","deviceClass":"motor","setting":{"reversed":"false","fwd":"forward","rev":"reverse","gear":"ratio18_1","id":"partner"}}],"slot":1,"platform":"V5","sdkVersion":"20240802.15.00.00","appVersion":"4.68.0","fileFormat":"2.0.0","targetBrainGen":"First","v5Sounds":[{"name":"game over","url":"static/sounds/mixkit-arcade-retro-game-over-213.wav"}],"v5SoundsEnabled":false,"aiVisionSettings":{"colors":[],"codes":[],"tags":true,"AIObjects":true,"AIObjectModel":[],"aiModelDropDownValue":null}}