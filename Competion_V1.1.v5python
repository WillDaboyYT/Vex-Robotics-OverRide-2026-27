{"mode":"Text","hardwareTarget":"brain","textContent":"from vex import *\nimport random\nimport math\n\n\n# ============================================================\n# COMPETITION V1.1\n# ============================================================\n#\n# This program is based on the original \"alliance_gui\" code.\n#\n# V1.1 is mainly a documentation and readability update.\n# The goal is to make the program easier to understand,\n# troubleshoot, and expand as the physical robot develops.\n#\n# Major systems currently included:\n#   - Arcade drivetrain\n#   - Adjustable drive speed\n#   - Cascade lift\n#   - Roller / intake\n#   - Claw wrist\n#   - Claw grab\n#   - Controller status screen\n#   - Motor temperature monitoring\n#   - Thermal warning system\n#   - Emergency thermal shutdown\n#   - IMU calibration\n#   - Competition framework\n#\n# Autonomous is intentionally left as a placeholder.\n# The physical robot needs to be tested before autonomous\n# distances, turns, and mechanism positions can be chosen.\n#\n# ============================================================\n\n\n# ============================================================\n# ROBOT HARDWARE CONFIGURATION\n# ============================================================\n#\n# IMPORTANT:\n# These are the original ports from the robot.\n# Do not change them unless the physical wiring changes.\n#\n# Keeping the hardware configuration at the top makes it\n# easier to find and verify the robot's wiring.\n# ============================================================\n\nbrain = Brain()\n\n\n# ---------------- LEFT DRIVE ----------------\n#\n# The two left motors are combined into one MotorGroup.\n# Both motors use the standard 18:1 cartridge setting.\n#\n# The \"False\" at the end means the motor is not reversed\n# relative to the normal VEX motor direction.\n\nleft_motor_a = Motor(\n    Ports.PORT1,\n    GearSetting.RATIO_18_1,\n    False\n)\n\nleft_motor_b = Motor(\n    Ports.PORT11,\n    GearSetting.RATIO_18_1,\n    False\n)\n\nleft_drive_smart = MotorGroup(\n    left_motor_a,\n    left_motor_b\n)\n\n\n# ---------------- RIGHT DRIVE ----------------\n#\n# The right motors are reversed because they are mounted\n# opposite the left side of the drivetrain.\n#\n# This allows FORWARD to mean forward for the entire robot.\n\nright_motor_a = Motor(\n    Ports.PORT10,\n    GearSetting.RATIO_18_1,\n    True\n)\n\nright_motor_b = Motor(\n    Ports.PORT20,\n    GearSetting.RATIO_18_1,\n    True\n)\n\nright_drive_smart = MotorGroup(\n    right_motor_a,\n    right_motor_b\n)\n\n\n# The inertial sensor is used by the SmartDrive system.\n# It will also be calibrated when the robot starts.\n\ndrivetrain_inertial = Inertial(Ports.PORT9)\n\n\n# SmartDrive contains the two drivetrain sides and the IMU.\n#\n# The physical measurements here came from the original\n# VEX-generated robot configuration, so they are preserved\n# rather than guessed or changed.\n\ndrivetrain = SmartDrive(\n    left_drive_smart,\n    right_drive_smart,\n    drivetrain_inertial,\n    319.19,\n    320,\n    177.79999999999998,\n    MM,\n    1\n)\n\n\n# ============================================================\n# CONTROLLER\n# ============================================================\n#\n# PRIMARY means this is the controller normally used by\n# the driver during a competition.\n# ============================================================\n\ncontroller_1 = Controller(PRIMARY)\n\n\n# ============================================================\n# MECHANISM MOTORS\n# ============================================================\n#\n# These motors control the robot's non-drivetrain systems.\n#\n# The names describe what each motor is intended to control.\n# ============================================================\n\n# Roller / intake motor.\nroller_Intake = Motor(\n    Ports.PORT12,\n    GearSetting.RATIO_18_1,\n    False\n)\n\n\n# Cascade lift motor.\ncascade_Lift = Motor(\n    Ports.PORT13,\n    GearSetting.RATIO_18_1,\n    False\n)\n\n\n# Motor that moves the claw wrist.\nclaw_Wrist = Motor(\n    Ports.PORT18,\n    GearSetting.RATIO_18_1,\n    False\n)\n\n\n# Motor that opens and closes the claw.\nclaw_Grab = Motor(\n    Ports.PORT19,\n    GearSetting.RATIO_18_1,\n    False\n)\n\n\n# ============================================================\n# GLOBAL SETTINGS\n# ============================================================\n#\n# These values control how the software behaves.\n# Keeping them together makes tuning easier later.\n# ============================================================\n\n\n# The starting drivetrain speed is 80%.\n#\n# This can be changed during driver control with A and Y.\ndrive_speed = 80\n\n\n# The driver cannot reduce the drivetrain below 20%.\n# This prevents accidentally selecting an extremely slow\n# drive setting that would make the robot difficult to use.\n\nMIN_DRIVE_SPEED = 20\n\n\n# 100% is the maximum software-selected drivetrain speed.\n\nMAX_DRIVE_SPEED = 100\n\n\n# A and Y change the drive speed by 10% at a time.\n\nDRIVE_SPEED_STEP = 10\n\n\n# Small joystick movements are ignored.\n#\n# This prevents the robot from slowly moving when the\n# joystick is supposed to be centered.\n\nJOYSTICK_DEADBAND = 5\n\n\n# ============================================================\n# TEMPERATURE SAFETY SETTINGS\n# ============================================================\n#\n# The robot has two levels of temperature protection.\n#\n# 70C:\n#   Warning level.\n#\n# 80C:\n#   Full emergency shutdown.\n#\n# The shutdown is intentionally latched so the robot cannot\n# automatically restart just because the motor cools down.\n# ============================================================\n\nTHERMAL_SHUTDOWN_TEMP = 80\n\nTHERMAL_WARNING_TEMP = 70\n\n\n# This flag tells every motor-control system that an\n# emergency thermal shutdown has occurred.\n\nthermal_shutdown = False\n\n\n# This controls whether normal driver control is allowed.\n#\n# Autonomous and driver control can change this flag so the\n# background driver loop does not need to be recreated.\n\ndriver_enabled = False\n\n\n# ============================================================\n# RANDOM SEED INITIALIZATION\n# ============================================================\n#\n# VEX's generated projects normally initialize a random seed.\n# We preserve that behavior so anything using random numbers\n# later will not always produce exactly the same sequence.\n# ============================================================\n\ndef initialize_random_seed():\n\n    # Give the Brain a moment to finish starting up.\n    wait(100, MSEC)\n\n    # Combine several changing hardware values to create\n    # a different seed each time the program starts.\n    seed_value = (\n        brain.battery.voltage(VOLT) * 100\n        + brain.battery.current() * 10\n        + brain.timer.system_high_res()\n    )\n\n    random.seed(int(seed_value))\n\n\n# ============================================================\n# IMU / DRIVETRAIN CALIBRATION\n# ============================================================\n#\n# The inertial sensor needs to calibrate while the robot is\n# sitting still.\n#\n# This function waits until calibration is actually finished\n# instead of immediately continuing with the program.\n# ============================================================\n\ndef calibrate_drivetrain():\n\n    brain.screen.clear_screen()\n\n    brain.screen.set_cursor(1, 1)\n    brain.screen.print(\"Calibrating IMU...\")\n\n    # Start inertial sensor calibration.\n    drivetrain_inertial.calibrate()\n\n\n    # Wait here until the IMU reports that calibration is done.\n    #\n    # This is important because autonomous and other systems\n    # should not use an uncalibrated heading.\n    while drivetrain_inertial.is_calibrating():\n\n        wait(50, MSEC)\n\n\n    # Tell the user that calibration has completed.\n    brain.screen.clear_screen()\n\n    brain.screen.set_cursor(1, 1)\n    brain.screen.print(\"IMU Ready\")\n\n    wait(500, MSEC)\n\n\n# ============================================================\n# MOTOR SAFETY\n# ============================================================\n#\n# This function provides one central way to stop every motor.\n#\n# Having one emergency stop function is useful because the\n# temperature system can call it immediately without needing\n# to know how every individual motor is controlled.\n# ============================================================\n\ndef stop_all_motors():\n\n    # Stop both left drivetrain motors.\n    left_motor_a.stop(BRAKE)\n    left_motor_b.stop(BRAKE)\n\n    # Stop both right drivetrain motors.\n    right_motor_a.stop(BRAKE)\n    right_motor_b.stop(BRAKE)\n\n    # Stop the mechanisms.\n    roller_Intake.stop(BRAKE)\n    cascade_Lift.stop(BRAKE)\n    claw_Wrist.stop(BRAKE)\n    claw_Grab.stop(BRAKE)\n\n\n# ============================================================\n# TEMPERATURE INFORMATION\n# ============================================================\n#\n# Temperature is read in actual Celsius degrees.\n#\n# The drivetrain motors are checked individually because one\n# motor could be significantly hotter than another motor.\n# ============================================================\n\ndef get_motor_temperatures():\n\n    # Return the motor name along with its current temperature.\n    #\n    # Short names are used for the drivetrain motors because\n    # they fit more easily on the controller screen.\n\n    return [\n        (\"LF\", left_motor_a.temperature(TemperatureUnits.CELSIUS)),\n        (\"LB\", left_motor_b.temperature(TemperatureUnits.CELSIUS)),\n        (\"RF\", right_motor_a.temperature(TemperatureUnits.CELSIUS)),\n        (\"RB\", right_motor_b.temperature(TemperatureUnits.CELSIUS)),\n        (\"LIFT\", cascade_Lift.temperature(TemperatureUnits.CELSIUS)),\n        (\"ROLL\", roller_Intake.temperature(TemperatureUnits.CELSIUS))\n    ]\n\n\n# Find the hottest motor anywhere on the robot.\n#\n# This is used for the emergency shutdown because we do not\n# want one overheated motor hidden by cooler motors.\n\ndef get_hottest_motor():\n\n    temperatures = get_motor_temperatures()\n\n    # Start by assuming the first motor is the hottest.\n    hottest_name = temperatures[0][0]\n    hottest_temp = temperatures[0][1]\n\n    # Compare every other motor against the current hottest.\n    for name, temperature in temperatures:\n\n        if temperature > hottest_temp:\n\n            hottest_name = name\n            hottest_temp = temperature\n\n    return hottest_name, hottest_temp\n\n\n# The controller only needs one drivetrain temperature.\n#\n# We display the hottest drivetrain motor because an average\n# temperature could hide a single motor getting too hot.\n\ndef get_drivetrain_temperature():\n\n    temperatures = [\n        left_motor_a.temperature(TemperatureUnits.CELSIUS),\n        left_motor_b.temperature(TemperatureUnits.CELSIUS),\n        right_motor_a.temperature(TemperatureUnits.CELSIUS),\n        right_motor_b.temperature(TemperatureUnits.CELSIUS)\n    ]\n\n    hottest = temperatures[0]\n\n    for temperature in temperatures:\n\n        if temperature > hottest:\n            hottest = temperature\n\n    return hottest\n\n\n# ============================================================\n# THERMAL SHUTDOWN DISPLAY\n# ============================================================\n#\n# When the robot overheats, the controller screen changes to\n# an obvious warning instead of continuing to show normal\n# driving information.\n# ============================================================\n\ndef thermal_shutdown_screen(motor_name, temperature):\n\n    controller_1.screen.clear_screen()\n\n    controller_1.screen.set_cursor(1, 1)\n    controller_1.screen.print(\"!!! OVERHEAT !!!\")\n\n    controller_1.screen.set_cursor(2, 1)\n    controller_1.screen.print(\"MOTOR: \" + motor_name)\n\n    controller_1.screen.set_cursor(3, 1)\n    controller_1.screen.print(\n        \"TEMP: \" + str(int(temperature)) + \"C\"\n    )\n\n\n# ============================================================\n# THERMAL PROTECTION SYSTEM\n# ============================================================\n#\n# This runs continuously in its own thread.\n#\n# It can therefore monitor motor temperatures even while the\n# driver-control loop is busy controlling the robot.\n# ============================================================\n\ndef monitor_temperature():\n\n    global thermal_shutdown\n\n    # This prevents the controller from constantly rumbling\n    # every 100 milliseconds while the robot is warm.\n    warning_active = False\n\n\n    while True:\n\n        # Find the hottest motor on the entire robot.\n        hottest_name, hottest_temp = get_hottest_motor()\n\n\n        # ----------------------------------------------------\n        # EMERGENCY SHUTDOWN\n        # ----------------------------------------------------\n        #\n        # 80C or higher immediately disables the robot.\n        # ----------------------------------------------------\n\n        if hottest_temp >= THERMAL_SHUTDOWN_TEMP:\n\n            # Permanently latch the shutdown state.\n            thermal_shutdown = True\n\n            # Immediately stop every motor.\n            stop_all_motors()\n\n            # Tell the driver that an emergency happened.\n            controller_1.rumble(\"--- --- ---\")\n\n\n            # Stay inside this loop forever once shutdown\n            # occurs. Cooling down will NOT automatically\n            # restart the robot.\n            while thermal_shutdown:\n\n                # Continue forcing all motors to remain stopped.\n                stop_all_motors()\n\n                # Show which motor caused the highest reading.\n                thermal_shutdown_screen(\n                    hottest_name,\n                    hottest_temp\n                )\n\n                # Update the displayed temperature.\n                hottest_name, hottest_temp = get_hottest_motor()\n\n                wait(250, MSEC)\n\n\n        # ----------------------------------------------------\n        # TEMPERATURE WARNING\n        # ----------------------------------------------------\n        #\n        # At 70C the robot is still allowed to operate, but\n        # the driver gets a warning through the controller.\n        # ----------------------------------------------------\n\n        elif hottest_temp >= THERMAL_WARNING_TEMP:\n\n            # Only rumble once when entering the warning range.\n            if not warning_active:\n\n                controller_1.rumble(\"--\")\n                warning_active = True\n\n\n        else:\n\n            # Once temperatures drop below the warning range,\n            # another warning can be triggered later.\n            warning_active = False\n\n\n        # Check temperatures frequently enough to react quickly\n        # without using unnecessary processor time.\n        wait(100, MSEC)\n\n\n# ============================================================\n# DRIVE SPEED ADJUSTMENT\n# ============================================================\n#\n# The driver can change the maximum drivetrain speed while\n# driving.\n#\n# A = decrease speed\n# Y = increase speed\n#\n# Each press changes the setting by 10%.\n# ============================================================\n\ndef increase_drive_speed():\n\n    global drive_speed\n\n    # Increase by one 10% step.\n    drive_speed += DRIVE_SPEED_STEP\n\n    # Never allow the setting above 100%.\n    if drive_speed > MAX_DRIVE_SPEED:\n\n        drive_speed = MAX_DRIVE_SPEED\n\n\ndef decrease_drive_speed():\n\n    global drive_speed\n\n    # Decrease by one 10% step.\n    drive_speed -= DRIVE_SPEED_STEP\n\n    # Never allow the setting below 20%.\n    if drive_speed < MIN_DRIVE_SPEED:\n\n        drive_speed = MIN_DRIVE_SPEED\n\n\n# ============================================================\n# DRIVE SPEED BUTTON MONITOR\n# ============================================================\n#\n# A normal \"pressing()\" check would run many times while a\n# button is held down.\n#\n# This system remembers the previous button state so one press\n# produces exactly one speed adjustment.\n# ============================================================\n\ndef monitor_drive_speed_buttons():\n\n    # These remember whether each button was pressed during\n    # the previous check.\n    previous_a = False\n    previous_y = False\n\n\n    while True:\n\n        # Read the current button states.\n        current_a = controller_1.buttonA.pressing()\n        current_y = controller_1.buttonY.pressing()\n\n\n        # A changes speed only when it transitions from\n        # unpressed to pressed.\n        if current_a and not previous_a:\n\n            decrease_drive_speed()\n\n\n        # Y works the same way in the opposite direction.\n        if current_y and not previous_y:\n\n            increase_drive_speed()\n\n\n        # Save the current state for the next loop.\n        previous_a = current_a\n        previous_y = current_y\n\n\n        # A short delay prevents the button monitor from\n        # running unnecessarily fast.\n        wait(20, MSEC)\n\n\n# ============================================================\n# JOYSTICK DEADZONE\n# ============================================================\n#\n# Joysticks can report tiny values even when the driver thinks\n# the stick is centered.\n#\n# The deadband removes those tiny values.\n# ============================================================\n\ndef apply_deadband(value):\n\n    # If the stick is close enough to center, treat it as zero.\n    if abs(value) <= JOYSTICK_DEADBAND:\n\n        return 0\n\n    return value\n\n\n# ============================================================\n# JOYSTICK CURVE\n# ============================================================\n#\n# A cubic curve makes the robot easier to control around the\n# center of the joystick.\n#\n# Small movements become much smaller motor commands while\n# full joystick movement still reaches full power.\n# ============================================================\n\ndef curve_joystick(value):\n\n    # Zero should remain exactly zero.\n    if value == 0:\n\n        return 0\n\n\n    # Cubing the value creates a softer response near center.\n    #\n    # Dividing by 10000 keeps the final range around -100\n    # to +100.\n    return (value * value * value) / 10000\n\n\n# ============================================================\n# MAIN DRIVER CONTROL LOOP\n# ============================================================\n#\n# This is the only function that directly controls the robot\n# during normal driver operation.\n#\n# Keeping one driver-control system prevents two different\n# loops from fighting over the same motors.\n# ============================================================\n\ndef driver_control_loop():\n\n    global driver_enabled\n\n\n    while True:\n\n        # ----------------------------------------------------\n        # SAFETY OVERRIDE\n        # ----------------------------------------------------\n        #\n        # Thermal shutdown always has priority over driver\n        # commands.\n        # ----------------------------------------------------\n\n        if thermal_shutdown:\n\n            stop_all_motors()\n\n            wait(20, MSEC)\n            continue\n\n\n        # ----------------------------------------------------\n        # DRIVER ENABLE CHECK\n        # ----------------------------------------------------\n        #\n        # Motors are stopped whenever driver control is not\n        # currently enabled.\n        # ----------------------------------------------------\n\n        if not driver_enabled:\n\n            stop_all_motors()\n\n            wait(20, MSEC)\n            continue\n\n\n        # ====================================================\n        # DRIVETRAIN\n        # ====================================================\n\n        # Axis 3 controls forward and reverse.\n        forward = controller_1.axis3.position()\n\n        # Axis 1 controls turning.\n        turn = controller_1.axis1.position()\n\n\n        # Remove tiny joystick movements.\n        forward = apply_deadband(forward)\n        turn = apply_deadband(turn)\n\n\n        # Apply the smoother cubic response.\n        forward = curve_joystick(forward)\n        turn = curve_joystick(turn)\n\n\n        # Arcade drive combines forward movement and turning.\n        #\n        # Turning is added to one side and subtracted from\n        # the other side to create the turn.\n        left_power = forward + turn\n        right_power = forward - turn\n\n\n        # ----------------------------------------------------\n        # LIMIT DRIVETRAIN OUTPUT\n        # ----------------------------------------------------\n        #\n        # Combining forward and turning can create a value\n        # greater than 100, so clamp both sides.\n        # ----------------------------------------------------\n\n        if left_power > 100:\n            left_power = 100\n\n        if left_power < -100:\n            left_power = -100\n\n        if right_power > 100:\n            right_power = 100\n\n        if right_power < -100:\n            right_power = -100\n\n\n        # Apply the driver's selected maximum speed.\n        #\n        # Example:\n        #   100 joystick power at 80% speed = 80 motor power.\n        left_power = left_power * drive_speed / 100\n        right_power = right_power * drive_speed / 100\n\n\n        # ----------------------------------------------------\n        # LEFT DRIVETRAIN\n        # ----------------------------------------------------\n\n        if left_power > 0:\n\n            left_drive_smart.set_velocity(\n                abs(left_power),\n                PERCENT\n            )\n\n            left_drive_smart.spin(FORWARD)\n\n        elif left_power < 0:\n\n            left_drive_smart.set_velocity(\n                abs(left_power),\n                PERCENT\n            )\n\n            left_drive_smart.spin(REVERSE)\n\n        else:\n\n            # Brake when the joystick returns to center.\n            left_drive_smart.stop(BRAKE)\n\n\n        # ----------------------------------------------------\n        # RIGHT DRIVETRAIN\n        # ----------------------------------------------------\n\n        if right_power > 0:\n\n            right_drive_smart.set_velocity(\n                abs(right_power),\n                PERCENT\n            )\n\n            right_drive_smart.spin(FORWARD)\n\n        elif right_power < 0:\n\n            right_drive_smart.set_velocity(\n                abs(right_power),\n                PERCENT\n            )\n\n            right_drive_smart.spin(REVERSE)\n\n        else:\n\n            # Brake the right side when it is not commanded.\n            right_drive_smart.stop(BRAKE)\n\n\n        # ====================================================\n        # CASCADE LIFT\n        # ====================================================\n        #\n        # L1 raises the lift.\n        # L2 lowers the lift.\n        # Releasing both buttons stops the lift.\n        # ====================================================\n\n        if controller_1.buttonL1.pressing():\n\n            cascade_Lift.set_velocity(100, PERCENT)\n            cascade_Lift.spin(FORWARD)\n\n        elif controller_1.buttonL2.pressing():\n\n            cascade_Lift.set_velocity(100, PERCENT)\n            cascade_Lift.spin(REVERSE)\n\n        else:\n\n            cascade_Lift.stop(BRAKE)\n\n\n        # ====================================================\n        # ROLLER / INTAKE\n        # ====================================================\n        #\n        # R1 and R2 provide opposite directions for the roller.\n        # ====================================================\n\n        if controller_1.buttonR1.pressing():\n\n            roller_Intake.set_velocity(100, PERCENT)\n            roller_Intake.spin(FORWARD)\n\n        elif controller_1.buttonR2.pressing():\n\n            roller_Intake.set_velocity(100, PERCENT)\n            roller_Intake.spin(REVERSE)\n\n        else:\n\n            roller_Intake.stop(BRAKE)\n\n\n        # ====================================================\n        # CLAW WRIST\n        # ====================================================\n        #\n        # D-pad Up moves the wrist forward.\n        # D-pad Down moves the wrist backward.\n        # ====================================================\n\n        if controller_1.buttonUp.pressing():\n\n            claw_Wrist.set_velocity(100, PERCENT)\n            claw_Wrist.spin(FORWARD)\n\n        elif controller_1.buttonDown.pressing():\n\n            claw_Wrist.set_velocity(100, PERCENT)\n            claw_Wrist.spin(REVERSE)\n\n        else:\n\n            claw_Wrist.stop(BRAKE)\n\n\n        # ====================================================\n        # CLAW GRAB\n        # ====================================================\n        #\n        # D-pad Left and Right control the two directions of\n        # the claw grab motor.\n        # ====================================================\n\n        if controller_1.buttonLeft.pressing():\n\n            claw_Grab.set_velocity(100, PERCENT)\n            claw_Grab.spin(FORWARD)\n\n        elif controller_1.buttonRight.pressing():\n\n            claw_Grab.set_velocity(100, PERCENT)\n            claw_Grab.spin(REVERSE)\n\n        else:\n\n            claw_Grab.stop(BRAKE)\n\n\n        # Run the driver loop about 50 times per second.\n        wait(20, MSEC)\n\n\n# ============================================================\n# CONTROLLER STATUS SCREEN\n# ============================================================\n#\n# The controller displays important robot information while\n# driving instead of showing a mode label that doesn't provide\n# much useful information to the driver.\n#\n# Example:\n#\n#   DRIVE:80% DT:42C\n#   LIFT:35C ROLL:38C\n#   A:-10% Y:+10%\n#\n# DT represents the hottest drivetrain motor.\n# ============================================================\n\ndef controller_status_screen():\n\n    while True:\n\n        # Do not overwrite the emergency shutdown display.\n        if thermal_shutdown:\n\n            wait(100, MSEC)\n            continue\n\n\n        # Read the current temperatures.\n        drivetrain_temp = get_drivetrain_temperature()\n\n        lift_temp = cascade_Lift.temperature(\n            TemperatureUnits.CELSIUS\n        )\n\n        roller_temp = roller_Intake.temperature(\n            TemperatureUnits.CELSIUS\n        )\n\n\n        # Clear the old information before drawing the new\n        # values so old numbers do not remain on screen.\n        controller_1.screen.clear_screen()\n\n\n        # Show the current drive speed and hottest drivetrain\n        # motor temperature.\n        controller_1.screen.set_cursor(1, 1)\n\n        controller_1.screen.print(\n            \"DRIVE:\" + str(drive_speed)\n            + \"% DT:\" + str(int(drivetrain_temp))\n            + \"C\"\n        )\n\n\n        # Show lift and roller temperatures.\n        controller_1.screen.set_cursor(2, 1)\n\n        controller_1.screen.print(\n            \"LIFT:\" + str(int(lift_temp))\n            + \"C ROLL:\" + str(int(roller_temp))\n            + \"C\"\n        )\n\n\n        # Remind the driver what A and Y do.\n        controller_1.screen.set_cursor(3, 1)\n\n        controller_1.screen.print(\n            \"A:-10% Y:+10%\"\n        )\n\n\n        # The screen does not need to update as often as the\n        # motor-control loop.\n        wait(250, MSEC)\n\n\n# ============================================================\n# PRE-AUTONOMOUS\n# ============================================================\n#\n# This runs before the competition begins.\n#\n# Autonomous movement is deliberately not implemented yet.\n# We need the actual robot assembled and tested before\n# choosing movement distances and mechanism positions.\n# ============================================================\n\ndef pre_autonomous():\n\n    global driver_enabled\n\n    # Driver control should not be active during setup.\n    driver_enabled = False\n\n    # Make sure no motor is moving during initialization.\n    stop_all_motors()\n\n\n    # Tell the driver that initialization has started.\n    brain.screen.clear_screen()\n\n    brain.screen.set_cursor(1, 1)\n    brain.screen.print(\"Robot Initializing\")\n\n    wait(500, MSEC)\n\n\n    # Calibrate the inertial sensor before competition.\n    calibrate_drivetrain()\n\n\n    # Show that initialization completed.\n    brain.screen.clear_screen()\n\n    brain.screen.set_cursor(1, 1)\n    brain.screen.print(\"READY\")\n\n    brain.screen.set_cursor(2, 1)\n    brain.screen.print(\n        \"Drive: \" + str(drive_speed) + \"%\"\n    )\n\n    wait(500, MSEC)\n\n\n# ============================================================\n# AUTONOMOUS\n# ============================================================\n#\n# This is intentionally only a placeholder.\n#\n# No distances, angles, speeds, or scoring positions are\n# guessed here because those need to be measured on the\n# physical robot.\n# ============================================================\n\ndef autonomous():\n\n    global driver_enabled\n\n    # Driver control must be disabled during autonomous.\n    driver_enabled = False\n\n    # Make sure all motors begin autonomous stopped.\n    stop_all_motors()\n\n\n    # Let the driver know autonomous was selected.\n    brain.screen.clear_screen()\n\n    brain.screen.set_cursor(1, 1)\n    brain.screen.print(\"AUTONOMOUS\")\n\n    brain.screen.set_cursor(2, 1)\n    brain.screen.print(\"NOT PROGRAMMED\")\n\n\n    # Keep this callback alive while the competition system\n    # considers the robot to be in autonomous mode.\n    while True:\n\n        # Thermal shutdown still overrides everything.\n        if thermal_shutdown:\n\n            stop_all_motors()\n\n        wait(100, MSEC)\n\n\n# ============================================================\n# DRIVER CONTROL CALLBACK\n# ============================================================\n#\n# Competition control calls this function when driver control\n# begins.\n#\n# The actual motor commands are handled by the persistent\n# driver_control_loop thread.\n# ============================================================\n\ndef user_control():\n\n    global driver_enabled\n\n\n    # Never enable driver control after a thermal shutdown.\n    if thermal_shutdown:\n\n        driver_enabled = False\n        stop_all_motors()\n\n\n        while thermal_shutdown:\n\n            wait(100, MSEC)\n\n        return\n\n\n    # Enable the main driver-control loop.\n    driver_enabled = True\n\n\n    # Show the driver that the robot has entered driver control.\n    brain.screen.clear_screen()\n\n    brain.screen.set_cursor(1, 1)\n    brain.screen.print(\"DRIVER CONTROL\")\n\n\n    # Keep the competition callback alive while driver control\n    # is active.\n    while True:\n\n        # A thermal shutdown can happen at any time.\n        if thermal_shutdown:\n\n            driver_enabled = False\n            stop_all_motors()\n\n        wait(100, MSEC)\n\n\n# ============================================================\n# START BACKGROUND SYSTEMS\n# ============================================================\n#\n# These systems run independently:\n#\n#   1. Temperature protection\n#   2. A/Y drive-speed buttons\n#   3. Controller status screen\n#   4. Main driver motor control\n#\n# Keeping them separate allows temperature protection to\n# continue working even while the driver is operating.\n# ============================================================\n\ninitialize_random_seed()\n\n\n# Temperature safety thread.\ntemperature_thread = Thread(\n    monitor_temperature\n)\n\n\n# Drive-speed button thread.\nspeed_thread = Thread(\n    monitor_drive_speed_buttons\n)\n\n\n# Controller information screen thread.\nscreen_thread = Thread(\n    controller_status_screen\n)\n\n\n# Main driver-control thread.\ndriver_thread = Thread(\n    driver_control_loop\n)\n\n\n# ============================================================\n# COMPETITION SYSTEM\n# ============================================================\n#\n# This connects the robot's driver and autonomous functions\n# to the VEX competition system.\n# ============================================================\n\ncompetition = Competition(\n    user_control,\n    autonomous\n)\n\n\n# ============================================================\n# RUN INITIALIZATION\n# ============================================================\n#\n# Pre-autonomous setup happens after the background systems\n# have been started.\n# ============================================================\n\npre_autonomous()\n\n\n# ============================================================\n# MAIN PROGRAM LOOP\n# ============================================================\n#\n# Most of the robot's work happens in the background threads.\n#\n# This loop simply keeps the main program alive and provides\n# another final safety check for thermal shutdown.\n# ============================================================\n\nwhile True:\n\n    # If the thermal system has triggered, continue forcing\n    # every motor to remain stopped.\n    if thermal_shutdown:\n\n        stop_all_motors()\n\n\n    # Keep the main program running without consuming the\n    # processor continuously.\n    wait(100, MSEC)","textLanguage":"python","robotConfig":[{"port":[1,11,10,20,9],"name":"drivetrain","customName":false,"deviceType":"Drivetrain","deviceClass":"smartdrive","setting":{"type":"4-motor","wheelSize":"wheel4in","gear":"ratio18_1","gearRatio":"1:1","direction":"fwd","gyroType":"inertial","width":"11.61","unit":"in","wheelbase":"7","wheelbaseUnit":"in","xOffset":"0","xOffsetUnit":"mm","yOffset":"0","yOffsetUnit":"mm","thetaOffset":"180"},"triportSourcePort":null},{"port":[],"name":"controller_1","customName":false,"deviceType":"Controller","deviceClass":"controller","setting":{"left":"cascade_Lift","leftDir":"false","right":"roller_Intake","rightDir":"false","upDown":"claw_Wrist","upDownDir":"false","xB":"","xBDir":"false","drive":"split","id":"primary"},"triportSourcePort":22},{"port":[12],"name":"roller_Intake","customName":true,"deviceType":"Motor","deviceClass":"motor","setting":{"reversed":"false","fwd":"forward","rev":"reverse","gear":"ratio18_1","id":"partner"},"triportSourcePort":22},{"port":[13],"name":"cascade_Lift","customName":true,"deviceType":"Motor","deviceClass":"motor","setting":{"reversed":"false","fwd":"forward","rev":"reverse","gear":"ratio18_1","id":"partner"}},{"port":[18],"name":"claw_Wrist","customName":true,"deviceType":"Motor","deviceClass":"motor","setting":{"reversed":"false","fwd":"forward","rev":"reverse","gear":"ratio18_1","id":"partner"}},{"port":[19],"name":"claw_Grab","customName":true,"deviceType":"Motor","deviceClass":"motor","setting":{"reversed":"false","fwd":"forward","rev":"reverse","gear":"ratio18_1","id":"partner"}}],"slot":1,"platform":"V5","sdkVersion":"20240802.15.00.00","appVersion":"4.68.0","fileFormat":"2.0.0","targetBrainGen":"First","v5Sounds":[{"name":"game over","url":"static/sounds/mixkit-arcade-retro-game-over-213.wav"}],"v5SoundsEnabled":false,"aiVisionSettings":{"colors":[],"codes":[],"tags":true,"AIObjects":true,"AIObjectModel":[],"aiModelDropDownValue":null}}